  "description": "Portfolio moderne d'ARTAX404 - Développeur web, créateur de PWA, monteur vidéo, créateur de jeux et community manager",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
