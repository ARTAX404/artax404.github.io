    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "eslint": "^8",
    "eslint-config-next": "15.2.4",
    "@next/bundle-analyzer": "^15.2.4"
  },
  "keywords": [
    "portfolio",
    "nextjs",
    "react",
    "typescript",
    "pwa",
